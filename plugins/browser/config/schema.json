{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "adapter": {
      "type": "string",
      "title": "Snapshot adapter",
      "enum": [
        "real_browser",
        "generic"
      ],
      "default": "real_browser"
    },
    "max_ranked_elements": {
      "type": "integer",
      "title": "Elements shown per snapshot",
      "default": 40,
      "minimum": 1,
      "maximum": 500
    },
    "state_memory_pages": {
      "type": "integer",
      "title": "Remembered pages",
      "default": 8,
      "minimum": 1,
      "maximum": 100
    },
    "snapshot_tools": {
      "type": "array",
      "title": "Snapshot tool names",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": [
        "browser_snapshot"
      ],
      "x-addLabel": "Add tool"
    },
    "disabled_tools": {
      "type": "array",
      "title": "Disabled browser tools",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": [
        "browser_console",
        "browser_network",
        "browser_evaluate",
        "browser_handle_dialog"
      ],
      "x-addLabel": "Add tool"
    },
    "weight_role": {
      "type": "number",
      "title": "Role ranking weight",
      "default": 1,
      "minimum": 0,
      "maximum": 10
    },
    "weight_visibility": {
      "type": "number",
      "title": "Visibility ranking weight",
      "default": 1,
      "minimum": 0,
      "maximum": 10
    },
    "weight_position": {
      "type": "number",
      "title": "Position ranking weight",
      "default": 1,
      "minimum": 0,
      "maximum": 10
    },
    "weight_text": {
      "type": "number",
      "title": "Text ranking weight",
      "default": 1,
      "minimum": 0,
      "maximum": 10
    },
    "weight_context": {
      "type": "number",
      "title": "Context ranking weight",
      "default": 1,
      "minimum": 0,
      "maximum": 10
    }
  }
}

# Keep the build context small and never ship dev/user state into the image.

# VCS / tooling
.git
.gitignore
.github
.cursor
.cursorrules
AGENTS.md
agent-transcripts
*.md
!README.md

# Python caches / envs
.venv
venv
# Candidate TTS engine venvs (tools/tts_lab/envs.py). Multi-GB each, and
# ".venv" does not match them. The targeted COPYs below keep them out of
# the image regardless, but without this every build still ships them to
# the daemon as build context.
.venvs
__pycache__
**/__pycache__
*.pyc
*.pyo
.pytest_cache
.ruff_cache
.mypy_cache

# Node — frontend deps + build output are reinstalled/rebuilt in the image
node_modules
web/node_modules
web/dist
web/.vite

# Tauri desktop shell — the container serves the web build, never builds the
# native app. Excluding the whole directory (not just its artifacts) also
# keeps a Rust-side edit from invalidating the cached `npm run build` layer.
web/src-tauri

# Tests
tests

# Runtime / user state under data/. The persona text + the active avatar
# bundle are kept (baked outside the volume and seeded into it on first
# boot); everything else under data/ is dev/user state and must not ship.
data/*.db
data/*.db-shm
data/*.db-wal
data/lancedb
data/documents
data/attachments
# Exclude persona runtime state, but keep the active avatar bundle so the
# image can seed it into the data volume on first boot.
data/personas/*
!data/personas/active
data/personas/active/runtime
data/uploads
data/app.log*
data/crashlog.txt
data/persona/self_image.txt
data/persona/golden_turns.jsonl

# Voice scratch. Only the Pocket-TTS speaker embeddings are wanted in the
# image, and the Dockerfile globs exactly those -- but auditions,
# generated fine-tuning datasets and studio takes accumulate here (34 MB
# and growing), and without this every build ships them to the daemon.
voices/*
!voices/*.safetensors

# Local config overrides + secrets must never be baked in
config/user.json
.env

# Misc
*.log
.DS_Store
